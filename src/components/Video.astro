---
/**
 * Short silent screencast.
 *
 * Requirements (enforced by `scripts/verify.mjs`):
 * - `public/videos/{slug}.webm` — VP9, no audio, under 4 MB.
 * - `public/videos/{slug}.webp` — poster frame, 16:9.
 *
 * No autoplay: the poster keeps the page light and the reader decides to play.
 */
interface Props {
  slug: string;
  caption?: string;
  alt: string;
}

const { slug, caption, alt } = Astro.props;

// `BASE_URL` keeps the clip working when the site is served from a subfolder
// (the GitHub Pages preview lives at `/docs/`).
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const src = `${base}/videos/${slug}.webm`;
const poster = `${base}/videos/${slug}.webp`;
---

<figure class="not-content my-6">
  <div class="ps-video">
    <video
      controls
      muted
      playsinline
      preload="none"
      poster={poster}
      aria-label={alt}
      width="1280"
      height="720"
    >
      <source src={src} type="video/webm" />
    </video>
  </div>
  {caption && <figcaption class="mt-2 text-sm opacity-75">{caption}</figcaption>}
</figure>
