---
/**
 * Screenshot with a mandatory alt text.
 *
 * Captures are generated by `scripts/screenshots/capture.mjs` in the application
 * repo from a deterministic demo dataset (`php artisan doc:demo`), in both
 * languages, and committed to `src/assets/screens/`. Astro optimizes them to
 * WebP at build time.
 *
 * The image is constrained to the article column and never overflows into the
 * "on this page" rail.
 */
import { Image } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
}

const { src, alt, caption } = Astro.props;
---

<figure class="not-content my-6">
  <Image
    src={src}
    alt={alt}
    widths={[480, 960, 1440]}
    sizes="(min-width: 72rem) 45rem, (min-width: 50rem) 60vw, 100vw"
    class="h-auto w-full rounded-xl border border-[var(--sl-color-hairline-light)]"
    loading="lazy"
    decoding="async"
  />
  {caption && <figcaption class="mt-2 text-sm opacity-75">{caption}</figcaption>}
</figure>
