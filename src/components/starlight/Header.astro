---
import config from 'virtual:starlight/user-config';

import Search from 'virtual:starlight/components/Search';
import SiteTitle from 'virtual:starlight/components/SiteTitle';

/**
 * Render the `Search` component if Pagefind is enabled or the default search
 * component has been overridden.
 */
const shouldRenderSearch =
  config.pagefind || config.components.Search !== '@astrojs/starlight/components/Search.astro';

const isSpanish = Astro.currentLocale?.startsWith('es') ?? false;

const freeTrial = isSpanish
  ? { href: 'https://picstome.com/es/precios/', label: 'Prueba gratis' }
  : { href: 'https://picstome.com/pricing/', label: 'Try for free' };

const login = {
  href: 'https://app.picstome.com/',
  label: isSpanish ? 'Login' : 'Log in',
};
---

{/*
  The default Starlight header aligns the search box with the article column.
  Here the search sits at the far right, next to the product links, so the
  header reads as one group: brand on the left, everything actionable on the
  right.
*/}
<div class="header">
  <div class="title-wrapper sl-flex"><SiteTitle /></div>
  <div class="header-end sl-flex print:hidden">
    {shouldRenderSearch && <div class="search-wrapper sl-flex"><Search /></div>}
    <nav class="header-actions sl-flex" aria-label={isSpanish ? 'Cuenta' : 'Account'}>
      <a class="header-action header-action--quiet" href={freeTrial.href}>{freeTrial.label}</a>
      <a class="header-action header-action--primary" href={login.href}>{login.label}</a>
    </nav>
  </div>
</div>

<style>
  @layer starlight.core {
    .header {
      display: flex;
      gap: var(--sl-nav-gap);
      align-items: center;
      height: 100%;
    }

    .title-wrapper {
      /* Prevent long titles overflowing and covering search and buttons. */
      overflow: clip;
      /* Avoid clipping the focus ring around the link inside the title. */
      padding: 0.25rem;
      margin: -0.25rem;
      min-width: 0;
      flex: 0 1 auto;
    }

    .header-end {
      align-items: center;
      gap: 0.5rem;
      margin-inline-start: auto;
      min-width: 0;
    }

    .search-wrapper {
      align-items: center;
      width: clamp(12rem, 20vw, 20rem);
    }

    .header-actions {
      align-items: center;
      gap: 0.5rem;
      flex-shrink: 0;
    }

    .header-action {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      height: 2.25rem;
      padding-inline: 0.875rem;
      border: 1px solid transparent;
      border-radius: 0.5rem;
      color: var(--sl-color-text);
      font-size: var(--sl-text-sm);
      font-weight: 600;
      line-height: 1;
      text-decoration: none;
      white-space: nowrap;
      transition:
        background-color 120ms ease,
        border-color 120ms ease,
        color 120ms ease;
    }

    .header-action--quiet {
      border-color: color-mix(in srgb, var(--sl-color-text) 30%, transparent);
    }

    .header-action--quiet:hover {
      background-color: color-mix(in srgb, var(--sl-color-text) 9%, transparent);
    }

    /* Deep green on the sage bar; sage on the dark bar, where deep green
       would disappear. */
    .header-action--primary {
      border-color: #316d61;
      background-color: #316d61;
      color: #fff9ec;
    }

    .header-action--primary:hover {
      border-color: #27564c;
      background-color: #27564c;
      color: #fff9ec;
    }

    :global(:root[data-theme='dark']) .header-action--primary {
      border-color: #c6d8af;
      background-color: #c6d8af;
      color: #161e1b;
    }

    :global(:root[data-theme='dark']) .header-action--primary:hover {
      border-color: #d7eae4;
      background-color: #d7eae4;
      color: #161e1b;
    }

    .header-action:focus-visible {
      outline: 2px solid var(--sl-color-text-accent);
      outline-offset: 2px;
    }

    @media (max-width: 49.99rem) {
      .header {
        gap: 0.375rem;
      }

      .header-end {
        gap: 0.25rem;
      }

      .search-wrapper {
        width: auto;
      }

      .header-actions {
        gap: 0.25rem;
      }

      /* The free-trial label is longer than "Pricing", so the phone bar runs
         at a slightly smaller type size to keep the logo at its full width. */
      .header-action {
        height: 2rem;
        padding-inline: 0.5rem;
        font-size: var(--sl-text-2xs);
      }
    }

    /* On the narrowest phones, "Try for free" would push the brand and the
       menu button together. The link is still one tap away from any article
       and from the product itself. */
    @media (max-width: 23.5rem) {
      .header-action--quiet {
        display: none;
      }
    }
  }
</style>
