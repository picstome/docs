---
/**
 * Service status board.
 *
 * The UptimeRobot public feed answers with JSON *and* allows cross-origin
 * requests, but it occasionally returns the status page HTML instead (and it is
 * rate limited). So the page is rendered static — indexable, no build-time
 * network dependency — and the board hydrates itself in the browser, retrying a
 * few times and refreshing every minute while the tab stays open.
 *
 * The feed URL is deliberately not exposed in the UI: the reader wants to know if
 * Picstome works, not which monitoring vendor is behind it.
 *
 * The copy is resolved from `Astro.currentLocale` at build time.
 */
// Starlight reports the configured BCP-47 tag (`es-ES`, `en-US`), not the
// locale key, so the comparison has to be a prefix check.
const isSpanish = (Astro.currentLocale ?? 'en').toLowerCase().startsWith('es');

const copy = isSpanish
  ? {
      loading: 'Consultando el estado…',
      up: 'Picstome funciona con normalidad',
      down: 'Picstome está caído ahora mismo',
      unknown: 'No hemos podido consultar el estado',
      working: 'Funciona',
      broken: 'Caído',
      degraded: 'Sin datos',
      uptime: 'de disponibilidad en 30 días',
      missing: 'Sin datos para este servicio',
      incident: 'Último incidente',
      minutes: 'min',
      checked: 'Actualizado a las',
      feedDown: 'No hemos podido consultar el estado desde tu navegador.',
      retry: 'Reintentar',
      services: [
        { name: 'app.picstome.com', label: 'La app', description: 'Galerías, clientes, contratos, facturas y pagos.' },
        { name: 'picstome.com', label: 'La web', description: 'Páginas de producto, descargas y este centro de ayuda.' },
      ],
    }
  : {
      loading: 'Checking the status…',
      up: 'Picstome is working normally',
      down: 'Picstome is down right now',
      unknown: 'We could not read the status',
      working: 'Working',
      broken: 'Down',
      degraded: 'No data',
      uptime: 'uptime over 30 days',
      missing: 'No data for this service',
      incident: 'Last incident',
      minutes: 'min',
      checked: 'Updated at',
      feedDown: 'We could not read the status from your browser.',
      retry: 'Try again',
      services: [
        { name: 'app.picstome.com', label: 'The app', description: 'Galleries, clients, contracts, invoices and payments.' },
        { name: 'picstome.com', label: 'The website', description: 'Product pages, downloads and this help center.' },
      ],
    };
---

<div class="not-content my-6" data-status-board data-locale={isSpanish ? 'es' : 'en'}>
  <div class="ps-status-hero" data-state="loading">
    <span class="ps-status-hero-dot" data-overall></span>
    <div class="ps-status-hero-text">
      <strong data-headline>{copy.loading}</strong>
      <p data-updated>{copy.loading}</p>
    </div>
  </div>

  <div class="ps-status-grid">
    {
      copy.services.map((service) => (
        <div class="ps-status-card" data-card={service.name}>
          <span class="ps-dot" data-state="degraded" data-dot={service.name}></span>
          <div>
            <strong>
              {service.label} <span class="ps-status-host">{service.name}</span>
            </strong>
            <p class="mt-1 text-sm opacity-80">{service.description}</p>
            <p class="mt-1 text-sm opacity-70" data-summary={service.name}>
              {copy.loading}
            </p>
            <p class="mt-1 text-sm opacity-60" data-incident={service.name} hidden></p>
          </div>
        </div>
      ))
    }
  </div>

  <p class="mt-4 text-sm" data-fallback hidden>
    {copy.feedDown}{' '}
    <button type="button" class="ps-status-retry" data-retry>{copy.retry}</button>
  </p>
</div>

<script define:vars={{ copy, isSpanish }}>
  (() => {
    const board = document.querySelector('[data-status-board]');
    if (!board) {
      return;
    }

    const FEED = 'https://stats.uptimerobot.com/api/getMonitorList/fblMSj5psA';
    const SERVICES = copy.services.map((service) => service.name);
    const stateFor = (statusClass) => (statusClass === 'success' ? 'up' : statusClass === 'danger' ? 'down' : 'degraded');
    const labelFor = (state) => (state === 'up' ? copy.working : state === 'down' ? copy.broken : copy.degraded);
    const dateFor = (value) =>
      new Date(value.trim().replace(' ', 'T') + 'Z').toLocaleString(isSpanish ? 'es-ES' : 'en-US', {
        dateStyle: 'medium',
        timeStyle: 'short',
        timeZone: 'UTC',
      });

    const setText = (selector, text) => {
      const node = board.querySelector(selector);
      if (node) {
        node.textContent = text;
      }
    };

    const paint = (monitors) => {
      const states = SERVICES.map((name) => {
        const monitor = monitors.find((entry) => entry.name === name);
        const state = monitor ? stateFor(monitor.statusClass) : 'degraded';
        const dot = board.querySelector(`[data-dot="${name}"]`);
        if (dot) {
          dot.dataset.state = state;
        }
        const card = board.querySelector(`[data-card="${name}"]`);
        if (card) {
          card.dataset.state = state;
        }
        setText(
          `[data-summary="${name}"]`,
          monitor
            ? `${labelFor(state)}${monitor.ratio?.ratio ? ` · ${monitor.ratio.ratio}% ${copy.uptime}` : ''}`
            : copy.missing
        );

        const incident = board.querySelector(`[data-incident="${name}"]`);
        if (incident) {
          if (monitor?.lastDowntime) {
            incident.hidden = false;
            incident.textContent = `${copy.incident}: ${dateFor(monitor.lastDowntime.date)} (${Math.round(
              monitor.lastDowntime.duration / 60
            )} ${copy.minutes})`;
          } else {
            incident.hidden = true;
          }
        }

        return state;
      });

      const anyDown = states.includes('down');
      const allUp = states.every((state) => state === 'up');
      const hero = board.querySelector('.ps-status-hero');
      const overall = board.querySelector('[data-overall]');
      const overallState = anyDown ? 'down' : allUp ? 'up' : 'degraded';

      if (hero) {
        hero.dataset.state = overallState;
      }
      if (overall) {
        overall.dataset.state = overallState;
      }

      setText('[data-headline]', anyDown ? copy.down : allUp ? copy.up : copy.unknown);
      setText('[data-updated]', `${copy.checked} ${new Date().toLocaleTimeString(isSpanish ? 'es-ES' : 'en-US')}`);
    };

    const fail = () => {
      const hero = board.querySelector('.ps-status-hero');
      if (hero) {
        hero.dataset.state = 'degraded';
      }
      setText('[data-headline]', copy.unknown);
      setText('[data-updated]', copy.loading);

      const fallback = board.querySelector('[data-fallback]');
      if (fallback) {
        fallback.hidden = false;
      }
    };

    const load = async (attempt = 1) => {
      const fallback = board.querySelector('[data-fallback]');
      if (fallback) {
        fallback.hidden = true;
      }

      try {
        const response = await fetch(FEED, { headers: { accept: 'application/json' }, cache: 'no-store' });
        const body = await response.text();
        if (!response.ok || body.trimStart().startsWith('<')) {
          throw new Error(`unexpected response (${response.status})`);
        }
        paint(JSON.parse(body).data ?? []);
      } catch (error) {
        if (attempt < 3) {
          setTimeout(() => load(attempt + 1), 600 * attempt);
          return;
        }
        fail();
      }
    };

    const retry = board.querySelector('[data-retry]');
    if (retry) {
      retry.addEventListener('click', () => load());
    }

    load();
    setInterval(() => load(), 60_000);
  })();
</script>
